{
	"name": "PL_SOURCE_TO_SILVER_INNER",
	"properties": {
		"activities": [
			{
				"name": "READ_TABLE_DETAILS",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select * from ctrl.table_config where table_id = @{pipeline().parameters.table_id}",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_ASQL_TABLE_LIST",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "SET_START_TIME",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "START_TIME",
					"value": {
						"value": "@formatDateTime(utcNow(), 'yyyy-MM-dd-hh:mm:ss')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "SOURCE_TO_LANDING_INGESTION",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "READ_TABLE_DETAILS",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "SET_START_TIME",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "PostgreSqlV2Source",
						"query": {
							"value": "select * from public.@{activity('READ_TABLE_DETAILS').output.firstRow.source_table_name}",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_PGSQL_NEON",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DS_ADLS_PARQUET",
						"type": "DatasetReference",
						"parameters": {
							"folder": {
								"value": "@concat(\n    'landing', '/',\n    activity('READ_TABLE_DETAILS').output.firstRow.source_system, '/',\n    activity('READ_TABLE_DETAILS').output.firstRow.source_table_name, '/',\n    variables('START_TIME')\n    )",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "LANDING_TO_BRONZE",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "SOURCE_TO_LANDING_INGESTION",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/pulselink/pulselink-databrics/LANDING_TO_BRONZE",
					"baseParameters": {
						"source_system": {
							"value": "@activity('READ_TABLE_DETAILS').output.firstRow.source_system",
							"type": "Expression"
						},
						"table_name": {
							"value": "@activity('READ_TABLE_DETAILS').output.firstRow.bronze_table_name",
							"type": "Expression"
						},
						"landing_timestamp": {
							"value": "@variables('START_TIME')",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ADATABRICS_LS",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "BRONZE_TO_SILVER",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "LANDING_TO_BRONZE",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/pulselink/pulselink-databrics/BRONZE_TO_SILVER",
					"baseParameters": {
						"table_name": {
							"value": "@activity('READ_TABLE_DETAILS').output.firstRow.silver_table_name",
							"type": "Expression"
						},
						"landing_timestamp": {
							"value": "@variables('START_TIME')",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ADATABRICS_LS",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "UPDATE_SUCCESS_STATUS",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "BRONZE_TO_SILVER",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "ASQL_LS",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "update ctrl.audit_log\nset status = 'SUCCESS', end_time = sysutcdatetime(), records_written=@{activity('BRONZE_TO_SILVER').output.runOutput}\nwhere adf_run_id='@{pipeline().parameters.adf_run_id}' and table_id=@{pipeline().parameters.table_id}",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			}
		],
		"parameters": {
			"table_id": {
				"type": "int",
				"defaultValue": 1
			},
			"adf_run_id": {
				"type": "string",
				"defaultValue": "a2"
			}
		},
		"variables": {
			"START_TIME": {
				"type": "String"
			}
		},
		"annotations": []
	}
}